# ==============================================================================
# SpendIQ Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend:
#   cp .env.example .env
#
# IMPORTANT: Never commit the active .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
# Environment mode: "development" | "staging" | "production" | "testing"
ENVIRONMENT=development

# Application name displayed in API docs and logs
PROJECT_NAME="SpendIQ AI Financial Intelligence Platform"

# Application version (semver)
APP_VERSION=1.0.0

# API route prefix
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# Server Network Binding
# ------------------------------------------------------------------------------
# Bind host (0.0.0.0 for Docker containers, 127.0.0.1 for local dev)
HOST=0.0.0.0

# Port on which FastAPI / Uvicorn listens
PORT=8000

# Number of worker processes (recommended: 2 x CPU cores + 1 in production)
WORKERS=2

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Development (SQLite with async driver):
DATABASE_URL=sqlite+aiosqlite:///./spendiq.db

# Production (PostgreSQL with asyncpg driver):
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# Example: DATABASE_URL=postgresql+asyncpg://spendiq_admin:SuperSecurePassword123!@localhost:5432/spendiq_prod

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# Security & Authentication (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret key for signing JWT tokens.
# IN PRODUCTION: You MUST generate a fresh 64-character secret.
# Generate command:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=spendiq_super_secret_jwt_key_for_development_purposes_only_32char

# JWT signature algorithm (HS256 is recommended)
JWT_ALGORITHM=HS256

# JWT access token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh token expiration in days (default: 30 days)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Allowed origins for browser clients.
# Format: JSON array or comma-separated list of URLs without trailing slashes.
# In production, ONLY include your exact deployed frontend domains.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Artificial Intelligence & LLM Provider
# ------------------------------------------------------------------------------
# Provider: "mock" (built-in deterministic financial engine, zero external cost)
#           "openai" (requires OPENAI_API_KEY)
#           "gemini" (requires GEMINI_API_KEY)
#           "anthropic" (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=mock

# LLM Provider API Key (optional if LLM_PROVIDER is mock)
LLM_API_KEY=

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
# Log level: "DEBUG" | "INFO" | "WARNING" | "ERROR" | "CRITICAL"
LOG_LEVEL=INFO

# Optional: Sentry DSN for production error monitoring & tracing
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Background Processing & Cache
# ------------------------------------------------------------------------------
# Redis connection URL for caching and async task queues
# Example: redis://:redispassword@localhost:6379/0
REDIS_URL=redis://localhost:6379/0
