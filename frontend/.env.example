# ==============================================================================
# SpendIQ Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting Vite or running build:
#   cp .env.example .env
# ==============================================================================

# Backend API Base URL
# For local dev without reverse proxy:
VITE_API_URL=http://127.0.0.1:8000/api/v1

# For production deployment with Nginx / Reverse Proxy proxying /api/v1:
# VITE_API_URL=/api/v1

# App metadata
VITE_APP_NAME="SpendIQ Financial Intelligence Platform"
VITE_APP_VERSION=1.0.0
