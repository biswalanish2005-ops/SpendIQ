# ==============================================================================
# SpendIQ Full Stack Docker Compose Environment Variables
# ==============================================================================
# Copy this file to .env at the root of the project:
#   cp .env.example .env
#
# IMPORTANT: In production, change ALL passwords and secrets before starting!
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Service
# ------------------------------------------------------------------------------
POSTGRES_USER=spendiq_admin
POSTGRES_PASSWORD=spendiq_secure_db_password_change_me
POSTGRES_DB=spendiq_prod
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis Cache & Background Queue Service
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# SpendIQ Backend API
# ------------------------------------------------------------------------------
ENVIRONMENT=production
APP_VERSION=1.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
LOG_LEVEL=INFO

# PostgreSQL Connection String used by Backend (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://spendiq_admin:spendiq_secure_db_password_change_me@db:5432/spendiq_prod

# Redis Connection URL
REDIS_URL=redis://redis:6379/0

# JWT Authentication Secret (MUST be at least 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=spendiq_production_secret_key_please_change_this_to_a_random_hex_token

# CORS Allowed Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# AI LLM Provider Configuration
LLM_PROVIDER=mock
LLM_API_KEY=

# ------------------------------------------------------------------------------
# SpendIQ Frontend Web App
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_URL=/api/v1
